NEXT_PUBLIC_SUPABASE_URL=
# Either name works (Supabase dashboard shows PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Reads photographed delivery notes (OCR) via Gemini.
GEMINI_API_KEY=
# Optional; defaults to the cheapest/fastest vision model.
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional demo login; the app stays open until all five are set.
# Server-only. The one phone that can log in, in international form (+9725XXXXXXXX).
DEMO_LOGIN_PHONE=
DEMO_LOGIN_PASSWORD=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
