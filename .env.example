NEXT_PUBLIC_SUPABASE_URL=
# Either name works (Supabase dashboard shows PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Reads photographed delivery notes (OCR) via Gemini.
GEMINI_API_KEY=
# Optional; defaults to the cheapest/fastest vision model.
GEMINI_MODEL=gemini-3.5-flash-lite
